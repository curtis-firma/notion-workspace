# Slack token with Lists scopes (xoxp or xoxb). Required.
SLACK_TOKEN=xoxp-your-slack-token

# Notion integration token (secret_...). Required.
NOTION_TOKEN=secret_your-notion-token

# Slack List (file/list) ID. Defaults to the Project tracker list.
SLACK_LIST_ID=F0BCT37CJ8N

# Notion database ID. Defaults to the Todos database.
NOTION_DATABASE_ID=a53be6ba-4973-824d-ae3f-014a7e3c9c46

# Notion data source ID (Notion API 2025+ data-source addressing).
NOTION_DATA_SOURCE_ID=25dbe6ba-4973-8217-b64e-071cd79ef4ce

# Conflict resolution strategy: last-edited-wins | slack-wins | notion-wins
CONFLICT_STRATEGY=last-edited-wins

# If true, plan and log changes but make no writes.
DRY_RUN=false
